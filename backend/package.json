{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "prisma generate && ts-node-dev --files --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "make-admin": "ts-node-dev --transpile-only prisma/make-admin.ts",
    "fix-image-urls": "ts-node-dev --transpile-only prisma/fix-image-urls.ts",
    "test": "node scripts/run-integration-tests.cjs --all",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:coverage": "node scripts/run-integration-tests.cjs --coverage",
    "test:watch": "jest --selectProjects unit --watch"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.0",
    "pix-utils": "^2.8.2",
    "prisma": "6.13.0",
    "qrcode": "^1.5.4"
  }
}
