# Copy to .env.test and replace placeholders with local test-only values.
# Integration tests apply migrations and clear records in this database.
NODE_ENV=test
PORT=3334

POSTGRES_USER=TEST_USER
POSTGRES_PASSWORD=TEST_PASSWORD
POSTGRES_PASSWORD_URLENCODED=TEST_PASSWORD_URLENCODED
POSTGRES_DB=hortifruti_test
DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/hortifruti_test?schema=public"
DATABASE_URL_DOCKER="postgresql://TEST_USER:TEST_PASSWORD@postgres:5432/hortifruti_test?schema=public"

REDIS_PASSWORD=TEST_REDIS_PASSWORD
REDIS_PASSWORD_URLENCODED=TEST_REDIS_PASSWORD_URLENCODED
REDIS_URL="redis://:TEST_REDIS_PASSWORD@redis:6379/1"
REDIS_URL_DOCKER="redis://:TEST_REDIS_PASSWORD@redis:6379/1"

JWT_SECRET=REPLACE_WITH_TEST_ONLY_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_TEST_ONLY_SECRET
JWT_EXPIRES_IN=1h

PIX_KEY=test-pix-key
PIX_NOME_RECEBEDOR=Feira Etec Teste
PIX_CIDADE=Jales
FRETE_ENTREGA=5

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
API_URL=http://localhost:3334
FRONTEND_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
