# Copie para .env e gere credenciais próprias (não use estes valores fictícios).
# O .env é ignorado pelo Git; nunca versionar segredos reais.

# ---------- Banco ----------
POSTGRES_USER=hortifruti
POSTGRES_PASSWORD=EXEMPLO_NAO_USAR_48_BYTES_ALEATORIOS
POSTGRES_PASSWORD_URLENCODED=EXEMPLO_NAO_USAR_48_BYTES_ALEATORIOS
POSTGRES_DB=hortifruti
DATABASE_URL=postgresql://hortifruti:EXEMPLO_NAO_USAR@localhost:5432/hortifruti?schema=public
DATABASE_URL_DOCKER=postgresql://hortifruti:EXEMPLO_NAO_USAR@postgres:5432/hortifruti?schema=public

# ---------- Redis ----------
REDIS_PASSWORD=EXEMPLO_NAO_USAR_48_BYTES_ALEATORIOS
REDIS_PASSWORD_URLENCODED=EXEMPLO_NAO_USAR_48_BYTES_ALEATORIOS
REDIS_URL=redis://:EXEMPLO_NAO_USAR@localhost:6379
REDIS_URL_DOCKER=redis://:EXEMPLO_NAO_USAR@redis:6379

# ---------- Auth ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=EXEMPLO_NAO_USAR_GERE_64_CARACTERES_ALEATORIOS
JWT_REFRESH_SECRET=OUTRO_EXEMPLO_NAO_USAR_SEGREDO_DIFERENTE
JWT_EXPIRES_IN=1d

# ---------- Pix ----------
PIX_KEY=chave-pix-de-exemplo
PIX_NOME_RECEBEDOR=RECEBEDOR EXEMPLO
PIX_CIDADE=CIDADE EXEMPLO
FRETE_ENTREGA=0.00

# ---------- Mercado Pago (opcional) ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- URLs ----------
API_URL=http://localhost:3333
# Cloudinary (opcional; sem as três credenciais, uploads usam disco local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pode ter mais de uma, separadas por vírgula
FRONTEND_URL=http://localhost:3000

# ---------- E-mail para recuperação de senha ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Google (Google Cloud Console > Credenciais > ID do cliente OAuth "Aplicativo da Web") ----------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
